# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets -- never commit a real key
.env
.env.*
!.env.example

# ORION run output: decisions, audit trails, persisted credibility scores
outputs/*
!outputs/.gitkeep

# OS / IDE
.DS_Store
.idea/
.vscode/

# graphify: keep the graph, not its caches
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
!graphify-out/graph.json
